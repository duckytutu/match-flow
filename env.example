JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NODE_ENV=development
PORT=8000

# Docker
POSTGRES_USER=pickleball
POSTGRES_PASSWORD=pickleball
POSTGRES_DB=pickleball 